# LLM
GEMINI_API_KEY=""
GOOGLE_API_KEY="" # alias for GEMINI_API_KEY
# Tracing (optional — no-op if unset per FINAL_ARCHITECTURE §7)
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# Domain hint (optional user-supplied, e.g. "AI/ML"); empty uses DOMAIN_HINT_DEFAULT
DOMAIN_HINT=
# Debug deliberate-error demo — corrupts attempt 1 only for Loom video
DEBUG_FORCE_FAIL=false

# Overrides (optional)
# GENERATE_MODEL=gemini-3.6-flash
# EVALUATE_MODEL=gemini-3.1-flash
# MAX_RETRIES=2
